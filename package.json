{
  "name": "cobot-zapier",
  "version": "2.15.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "validate": "npm run build && zapier validate",
    "build": "npm run clean && tsc",
    "push": "npm test && npm run build && zapier push",
    "clean": "rimraf ./lib ./build",
    "watch": "npm run clean && tsc --watch",
    "prepare": "husky install",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26",
    "@types/node-fetch": "^2.6.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nock": "^14.0.16",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "7",
    "vitest": "^4.1.11",
    "zapier-platform-cli": "^18.6.0"
  },
  "overrides": {
    "@types/babel__traverse": "7.20.2"
  },
  "private": true
