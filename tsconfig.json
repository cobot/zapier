{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "es2019",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["esnext", "DOM"],
    "types": ["node", "vitest/globals"],
    "isolatedModules": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true
  }
}
